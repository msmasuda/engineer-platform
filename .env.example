# Docker Compose
POSTGRES_USER="engineer-platform"
POSTGRES_PASSWORD="replace-with-a-strong-password"
POSTGRES_DB="engineer-platform"
POSTGRES_PORT="5432"
REDIS_PASSWORD="replace-with-a-strong-password"
REDIS_PORT="6379"
KV_REST_API_PORT="8079"

# PostgreSQL（Dockerホスト: 192.168.100.2）
POSTGRES_PRISMA_URL="postgresql://engineer-platform:replace-with-a-strong-password@192.168.100.2:5432/engineer-platform?sslmode=disable"
POSTGRES_URL_NON_POOLING="postgresql://engineer-platform:replace-with-a-strong-password@192.168.100.2:5432/engineer-platform?sslmode=disable"
DATABASE_URL="postgresql://engineer-platform:replace-with-a-strong-password@192.168.100.2:5432/engineer-platform?sslmode=disable"

# Redis（Dockerホスト: 192.168.100.2）
REDIS_URL="redis://default:replace-with-a-strong-password@192.168.100.2:6379"
KV_URL="redis://default:replace-with-a-strong-password@192.168.100.2:6379"
KV_REST_API_URL="http://192.168.100.2:8079"
KV_REST_API_TOKEN="replace-with-a-random-token"
KV_REST_API_READ_ONLY_TOKEN="replace-with-a-random-token"

# Auth.js (NextAuth.js)
# `npx auth secret` または `openssl rand -base64 33` などで生成した秘密鍵を設定
AUTH_SECRET="your-auth-secret-minimum-32-characters"

# Auth.js・パスワード再設定リンクのベースURL
AUTH_URL="http://localhost:3000"

# OAuth Providers (GitHub, Google, Apple)
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

AUTH_APPLE_ID="your-apple-client-id"
AUTH_APPLE_SECRET="your-apple-client-secret"

# Resend（コンタクト通知・パスワード再設定メール）
# ローカルでメールを送らず再設定URLをターミナルへ出す場合は "console"
PASSWORD_RESET_EMAIL_MODE="resend"
RESEND_API_KEY="re_your_api_key"
# Resendで検証済みのドメインを使用（例: Engineer Platform <onboarding@resend.dev>）
CONTACT_EMAIL_FROM="Engineer Platform <onboarding@resend.dev>"
